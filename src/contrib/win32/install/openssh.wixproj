<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
        <Platform Condition="'$(Platform)' == ''">x64</Platform>
        <!-- This ensures there is a default version if it is not defined as part of the release process with the actual product version -->
        <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
        <OutputName>openssh</OutputName>
        <OutputType>package</OutputType>
        <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
        <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
        <!-- preinstall.wxi is generated into the intermediate folder by EncodePreInstallScript below -->
        <IncludeSearchPaths>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(IntermediateOutputPath)))</IncludeSearchPaths>
        <!-- ICE61 warns that the Upgrade table covers the package's own version; that is intended (a rebuilt package
             replaces the installed one). -->
        <SuppressIces>ICE61</SuppressIces>
        <!-- CNDL1077: the PreInstallCommand property holds PowerShell type names in square brackets; they are literal text, not property references -->
        <SuppressSpecificWarnings>1077</SuppressSpecificWarnings>
        <DefineConstants>
            $(DefineConstants);
            ProductVersion=$(ProductVersion);
        </DefineConstants>
        <DefineSolutionProperties>false</DefineSolutionProperties>
        <!-- Assumes WixToolPath is an input provided at runtime -->
        <!-- If building x86/x64 MSI and have Wix 3.11 installed, can also try the below line instead -->
        <!-- WixTargetsPath Condition="'$(WixTargetsPath)' == ''">$(MSBuildExtensionsPath)\Microsoft\WiX\v3.x\Wix.targets</WixTargetsPath -->
        <WixTargetsPath>$(WixToolPath)Wix.targets</WixTargetsPath>
        <WixTasksPath>$(WixToolPath)wixtasks.dll</WixTasksPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>
            $(DefineConstants);
            Debug;
        </DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <BindInputPaths Include="..\..\..\bin\$(Platform)\$(Configuration)" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="product.wxs" />
        <Compile Include="client.wxs" />
        <Compile Include="server.wxs" />
        <Compile Include="shared.wxs" />
        <!-- Content is part of the Compile inputs, so a change to the script rebuilds the package -->
        <Content Include="preinstall.ps1" />
    </ItemGroup>

    <ItemGroup>
        <WixExtension Include="WixFirewallExtension" />
        <WixExtension Include="WixUIExtension" />
        <WixExtension Include="WixUtilExtension" />
    </ItemGroup>

    <Import Project="$(WixTargetsPath)" />

    <!-- Embeds preinstall.ps1 into the package: writes $(IntermediateOutputPath)preinstall.wxi with two defines, each the
         base64 of a script (UTF-8, no BOM) that product.wxs passes to powershell.exe on its command line:
         - PreInstallScript: the file without its "#region firewall" parts (phases pre and sessions),
         - FirewallScript: the file without its "#region pre" parts (phases fwsave, fwrollback, fwcommit, firewall, port).
         Comment lines, blank lines and indentation are left out and every line ends with LF, so the package bytes do not
         depend on the line endings of the checkout. Windows limits a command line to 32767 characters; the build stops
         when a script leaves less than about 1700 characters for the rest of the command (powershell.exe path, install
         folder, arguments). tests\preinstall.Tests.ps1 checks that both scripts parse and keep every statement. -->
    <UsingTask TaskName="EmbedInstallerScript" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Source ParameterType="System.String" Required="true" />
            <Output ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Code Type="Fragment" Language="cs"><![CDATA[
var lines = File.ReadAllLines(Source);
var include = new StringBuilder("<Include>");
foreach (var variant in new[] { new[] { "PreInstallScript", "firewall" }, new[] { "FirewallScript", "pre" } })
{
    var script = new StringBuilder();
    bool skip = false;
    foreach (var line in lines)
    {
        var t = line.Trim();
        var region = System.Text.RegularExpressions.Regex.Match(t, @"^#(end)?region\s+(\w+)");
        if (region.Success && region.Groups[2].Value == variant[1]) { skip = !region.Groups[1].Success; continue; }
        if (skip || t.Length == 0 || t.StartsWith("#")) continue;
        script.Append(t).Append('\n');
    }
    var base64 = Convert.ToBase64String(new UTF8Encoding(false).GetBytes(script.ToString()));
    if (base64.Length > 31000)
    {
        Log.LogError("{0}: {1} characters of base64; at most 31000 fit on the powershell.exe command line. Move code into the other region or shorten the script.", variant[0], base64.Length);
        return false;
    }
    Log.LogMessage(MessageImportance.High, "{0}: {1} characters of base64 (command line limit 32767)", variant[0], base64.Length);
    include.Append("<?define ").Append(variant[0]).Append("=\"").Append(base64).Append("\"?>");
}
include.Append("</Include>\r\n");
File.WriteAllText(Output, include.ToString());
]]></Code>
        </Task>
    </UsingTask>
    <Target Name="EncodePreInstallScript" BeforeTargets="Compile">
        <MakeDir Directories="$(IncludeSearchPaths)" />
        <EmbedInstallerScript Source="$(MSBuildProjectDirectory)\preinstall.ps1" Output="$(IncludeSearchPaths)preinstall.wxi" />
    </Target>
</Project>
