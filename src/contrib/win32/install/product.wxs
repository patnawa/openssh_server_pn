<?xml version="1.0"?>

<?ifndef ProductVersion?>
<?error ProductVersion must be defined?>
<?endif?>

<!-- Generated by openssh.wixproj from preinstall.ps1: defines PreInstallScript and FirewallScript (base64 of the two
     scripts made from it). -->
<?include preinstall.wxi?>

<!-- Currently support x86, x64 builds. Assumes only previews are built as MSIs. -->
<!-- Each platform has its own UpgradeCode; the other two are listed so that a package of another
     architecture is removed as well: all of them register the same services and firewall rule. -->
<!-- SystemPowerShellFolder: the path the custom actions give for powershell.exe. QuietExec: the WixCA entry point that
     runs it. WixCA is an x86 binary in every package; WixQuietExec would start the 32-bit PowerShell of SysWOW64 (on
     Windows on ARM an emulated one, about 75 seconds per start), so the x64 and ARM64 packages use WixQuietExec64,
     which lifts the file system redirection and starts the native PowerShell. preinstall.ps1 works in both: it
     reaches native tools through Sysnative only when it runs in a 32-bit process.
     Every powershell.exe command line has -InputFormat None. WixQuietExec gives the process a pipe as standard input
     and keeps its write end open until the process has ended (wcautil qtexec.cpp). Windows PowerShell 2.0, the
     version of Windows 7 and Windows Server 2008 R2 as shipped, reads a redirected standard input to its end before it
     exits, so without the switch every step waited for ever and the installation hung there; PowerShell 3.0 and
     later read it only for a command that uses $input. The command lines are CustomAction.Target values, at most 255
     characters. tests\package.Tests.ps1 checks both. -->
<!-- FirewallSchedAction: the WiX action that schedules the creation of the firewall rule. The ARM64 package uses the
     _A64 variant; naming the x86 one there would add a second, x86 copy of the WiX firewall actions. -->
<?if $(var.Platform) = "x64"?>
<?define InstallerVersion = "200"?>
<?define ProgramFilesFolder = "ProgramFiles64Folder"?>
<?define SystemPowerShellFolder = "System64Folder"?>
<?define QuietExec = "WixQuietExec64"?>
<?define QuietExecCmdLine = "WixQuietExec64CmdLine"?>
<?define FirewallSchedAction = "WixSchedFirewallExceptionsInstall"?>
<?define UpgradeCode = "9E9D0D93-E70D-4424-ADBD-AD3B226A226D"?>
<?define OtherUpgradeCodeA = "2A1799F1-5B26-4DDC-A0C7-03F75C4C08D2"?>
<?define OtherArchA = "X86"?>
<?define OtherUpgradeCodeB = "5D153A07-920A-4978-8B33-8447DD4C42F9"?>
<?define OtherArchB = "ARM64"?>
<?elseif $(var.Platform) = "x86"?>
<?define InstallerVersion = "200"?>
<?define ProgramFilesFolder = "ProgramFilesFolder"?>
<?define SystemPowerShellFolder = "SystemFolder"?>
<?define QuietExec = "WixQuietExec"?>
<?define QuietExecCmdLine = "WixQuietExecCmdLine"?>
<?define FirewallSchedAction = "WixSchedFirewallExceptionsInstall"?>
<?define UpgradeCode = "2A1799F1-5B26-4DDC-A0C7-03F75C4C08D2"?>
<?define OtherUpgradeCodeA = "9E9D0D93-E70D-4424-ADBD-AD3B226A226D"?>
<?define OtherArchA = "X64"?>
<?define OtherUpgradeCodeB = "5D153A07-920A-4978-8B33-8447DD4C42F9"?>
<?define OtherArchB = "ARM64"?>
<?elseif $(var.Platform) = "ARM64"?>
<!-- Windows Installer 5.0 is the minimum for ARM64 packages; WiX raises a lower value with warning CNDL1143 -->
<?define InstallerVersion = "500"?>
<?define ProgramFilesFolder = "ProgramFiles64Folder"?>
<?define SystemPowerShellFolder = "System64Folder"?>
<?define QuietExec = "WixQuietExec64"?>
<?define QuietExecCmdLine = "WixQuietExec64CmdLine"?>
<?define FirewallSchedAction = "WixSchedFirewallExceptionsInstall_A64"?>
<?define UpgradeCode = "5D153A07-920A-4978-8B33-8447DD4C42F9"?>
<?define OtherUpgradeCodeA = "9E9D0D93-E70D-4424-ADBD-AD3B226A226D"?>
<?define OtherArchA = "X64"?>
<?define OtherUpgradeCodeB = "2A1799F1-5B26-4DDC-A0C7-03F75C4C08D2"?>
<?define OtherArchB = "X86"?>
<?else?>
<?error Platform $(var.Platform) is not supported?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <!-- OpenSSH Server PN (https://github.com/patnawa/openssh_server_pn). The upgrade codes above are
         the ones of the upstream Windows packages, so that installed official packages and earlier
         builds are recognised and replaced. -->
    <Product Id="*" Name="OpenSSH Server PN" Version="$(var.ProductVersion)" Language="1033" Manufacturer="OpenSSH Server PN" UpgradeCode="$(var.UpgradeCode)">
        <Package Compressed="yes" InstallerVersion="$(var.InstallerVersion)" InstallScope="perMachine" Description="OpenSSH Server PN $(var.ProductVersion)" Comments="OpenSSH server and client for Windows" />
        <MediaTemplate EmbedCab="yes" />

        <!-- Apps & features / Programs and Features: support and information links -->
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/patnawa/openssh_server_pn" />
        <Property Id="ARPHELPLINK" Value="https://github.com/patnawa/openssh_server_pn/issues" />

        <!-- Installed packages are removed before the new files are copied (RemoveExistingProducts
             right after InstallInitialize, so a failed install rolls back to the previous package):
             - an older or same-version package of any architecture (x86, x64 and ARM64 register the same
               services, so only one can be present; a rebuilt package replaces the installed one instead
               of failing with 1638),
             - a newer package of any architecture only with ALLOWDOWNGRADE=1; without it the install stops
               below and nothing is changed.
             Every row needs its own ActionProperty. Feature selection (client-only, server-only) is carried
             over from the removed package. -->
        <Upgrade Id="$(var.UpgradeCode)">
            <UpgradeVersion Minimum="0.0.0.0" IncludeMinimum="yes" Maximum="$(var.ProductVersion)" IncludeMaximum="yes" Property="OPENSSH_PREVIOUS_INSTALLED" MigrateFeatures="yes" />
            <UpgradeVersion Minimum="$(var.ProductVersion)" IncludeMinimum="no" Property="OPENSSH_NEWER_INSTALLED" MigrateFeatures="yes" />
        </Upgrade>
        <Upgrade Id="$(var.OtherUpgradeCodeA)">
            <UpgradeVersion Minimum="0.0.0.0" IncludeMinimum="yes" Maximum="$(var.ProductVersion)" IncludeMaximum="yes" Property="OPENSSH_$(var.OtherArchA)_INSTALLED" MigrateFeatures="yes" />
            <UpgradeVersion Minimum="$(var.ProductVersion)" IncludeMinimum="no" Property="OPENSSH_$(var.OtherArchA)_NEWER_INSTALLED" MigrateFeatures="yes" />
        </Upgrade>
        <Upgrade Id="$(var.OtherUpgradeCodeB)">
            <UpgradeVersion Minimum="0.0.0.0" IncludeMinimum="yes" Maximum="$(var.ProductVersion)" IncludeMaximum="yes" Property="OPENSSH_$(var.OtherArchB)_INSTALLED" MigrateFeatures="yes" />
            <UpgradeVersion Minimum="$(var.ProductVersion)" IncludeMinimum="no" Property="OPENSSH_$(var.OtherArchB)_NEWER_INSTALLED" MigrateFeatures="yes" />
        </Upgrade>
        <Property Id="ALLOWDOWNGRADE" Secure="yes" />
        <Condition Message="A newer version of OpenSSH from this package series is already installed. To replace it with this older version, run the installer with ALLOWDOWNGRADE=1 (msiexec /i package.msi ALLOWDOWNGRADE=1), or uninstall the newer version first."><![CDATA[Installed OR ALLOWDOWNGRADE = 1 OR NOT (OPENSSH_NEWER_INSTALLED OR OPENSSH_$(var.OtherArchA)_NEWER_INSTALLED OR OPENSSH_$(var.OtherArchB)_NEWER_INSTALLED)]]></Condition>
        <Condition Message="OpenSSH is supported only on Windows 7 and newer."><![CDATA[VersionNT >= 601]]></Condition>
        <!-- These public properties are passed to the pre-install script, which runs as LocalSystem, inside single-quoted
             PowerShell strings. Only known values are accepted, so no command-line value can change that command.
             PowerShell also ends such a string at the typographic single quotes U+2018 to U+201B. INSTALLFOLDER may contain
             none of them except U+201B, which the package's code page (1252) cannot hold: a folder with that character only
             an administrator can give (a property or a transform), and every PowerShell step then fails to parse and does
             nothing. Character references are expanded only outside CDATA, hence the escaped < and > there. -->
        <Condition Message="FIREWALL_PROFILES must be all, domain,private, domain or private."><![CDATA[NOT FIREWALL_PROFILES OR FIREWALL_PROFILES ~= "all" OR FIREWALL_PROFILES ~= "domain,private" OR FIREWALL_PROFILES ~= "domain" OR FIREWALL_PROFILES ~= "private"]]></Condition>
        <Condition Message="KEEP_INBOX_OPENSSH must be 1 or 0."><![CDATA[NOT KEEP_INBOX_OPENSSH OR KEEP_INBOX_OPENSSH = "1" OR KEEP_INBOX_OPENSSH = "0"]]></Condition>
        <Condition Message="INSTALLFOLDER must not contain an apostrophe or a typographic single quote.">NOT (INSTALLFOLDER &gt;&lt; "'" OR INSTALLFOLDER &gt;&lt; "&#x2018;" OR INSTALLFOLDER &gt;&lt; "&#x2019;" OR INSTALLFOLDER &gt;&lt; "&#x201A;")</Condition>
        <!-- A property value is compared as a number only when it is an integer (digits, an optional leading minus sign);
             any other text makes both comparisons false. -->
        <Condition Message="SSHD_PORT must be a TCP port number from 1 to 65535, digits only."><![CDATA[NOT SSHD_PORT OR (SSHD_PORT >= 1 AND SSHD_PORT <= 65535)]]></Condition>
        <Condition Message="ACTIVE_SESSIONS must be close or abort."><![CDATA[NOT ACTIVE_SESSIONS OR ACTIVE_SESSIONS ~= "close" OR ACTIVE_SESSIONS ~= "abort"]]></Condition>

        <!-- The in-box "OpenSSH Server" Windows capability registers the same sshd service, and Windows
             servicing of the capability (installing it, updates to it) points that service back at the in-box
             binary. preinstall.ps1 removes it unless KEEP_INBOX_OPENSSH=1. These searches only record its
             presence in the log; the script checks again at run time. -->
        <Property Id="KEEP_INBOX_OPENSSH" Secure="yes" />
        <Property Id="OPENSSH_INBOX_SERVER">
            <DirectorySearch Id="InboxOpenSSHFolder" Path="[WindowsFolder]System32\OpenSSH" Depth="0">
                <FileSearch Id="InboxSshdExe" Name="sshd.exe" />
            </DirectorySearch>
        </Property>
        <Property Id="OPENSSH_SSHD_IMAGEPATH">
            <RegistrySearch Id="SshdImagePath" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\sshd" Name="ImagePath" Type="raw" />
        </Property>

        <!-- preinstall.ps1 stops the services, ends leftover OpenSSH processes so that no file stays locked,
             removes the in-box server and keeps the sshd.exe process mitigation in place. It runs as a
             deferred action (LocalSystem) right after RemoveExistingProducts, and files that the removed
             package could not delete because a process still held them are moved aside and deleted at the end
             of the transaction, which succeeds once the script has ended those processes. On uninstall the
             action runs before the services are stopped and the files are removed, which also covers the
             nested uninstall of this package during a later upgrade.
             The cleanup is an improvement, never a gate: the script always exits 0 and Return="ignore" keeps
             the install going even if PowerShell cannot run at all (for example under a policy that forces
             constrained language mode); Windows Installer then falls back to its own file-in-use handling.
             PreInstallCommand and FirewallCommand are private properties (not formatted, so the brackets are
             literal; no column length limit; cannot be overridden from the command line) with the PowerShell
             expression that decodes and invokes one of the two scripts that openssh.wixproj makes from
             preinstall.ps1. Positional parameters: install folder, REMOVE, KEEP_INBOX_OPENSSH, phase,
             FIREWALL_PROFILES, MsiNTProductType; named: -SshdPort, -Previous. The firewall steps do not use REMOVE and
             KEEP_INBOX_OPENSSH and pass empty strings for them. Every value that reaches the
             single-quoted command is either set by Windows Installer or restricted by a launch condition above (for
             INSTALLFOLDER, all quote characters but U+201B; see there). -->
        <Property Id="PreInstallCommand" Value="&amp;([ScriptBlock]::Create([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('$(var.PreInstallScript)'))))" />
        <Property Id="FirewallCommand" Value="&amp;([ScriptBlock]::Create([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('$(var.FirewallScript)'))))" />
        <!-- Private properties populated after CostFinalize from resolved actions, never inferred from REMOVE.
             Shared files follow their component action, so removing one feature does not stop a retained agent. -->
        <Property Id="OpenSSHServerAction" Value="none" />
        <Property Id="OpenSSHClientAction" Value="none" />
        <Property Id="OpenSSHSharedAction" Value="none" />
        <SetProperty Action="ResolveServerInstall" Id="OpenSSHServerAction" Value="install" Sequence="execute" After="CostFinalize"><![CDATA[&Server = 3]]></SetProperty>
        <SetProperty Action="ResolveServerRemove" Id="OpenSSHServerAction" Value="remove" Sequence="execute" After="ResolveServerInstall"><![CDATA[&Server = 2 AND !Server = 3]]></SetProperty>
        <SetProperty Action="ResolveClientInstall" Id="OpenSSHClientAction" Value="install" Sequence="execute" After="ResolveServerRemove"><![CDATA[&Client = 3]]></SetProperty>
        <SetProperty Action="ResolveClientRemove" Id="OpenSSHClientAction" Value="remove" Sequence="execute" After="ResolveClientInstall"><![CDATA[&Client = 2 AND !Client = 3]]></SetProperty>
        <SetProperty Action="ResolveSharedInstall" Id="OpenSSHSharedAction" Value="install" Sequence="execute" After="ResolveClientRemove"><![CDATA[$SshAgentComponent = 3]]></SetProperty>
        <SetProperty Action="ResolveSharedRemove" Id="OpenSSHSharedAction" Value="remove" Sequence="execute" After="ResolveSharedInstall"><![CDATA[$SshAgentComponent = 2 AND ?SshAgentComponent = 3]]></SetProperty>
        <SetProperty Id="OpenSSHFeatureArguments" Value="-ServerAction '[OpenSSHServerAction]' -ClientAction '[OpenSSHClientAction]' -SharedAction '[OpenSSHSharedAction]'" Sequence="execute" After="ResolveSharedRemove" />
        <SetProperty Id="OpenSSHPreInstall" Sequence="execute" Before="OpenSSHPreInstall" Value="&quot;[$(var.SystemPowerShellFolder)]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -Command &quot;[PreInstallCommand] '[INSTALLFOLDER]' '[REMOVE]' '[KEEP_INBOX_OPENSSH]' [OpenSSHFeatureArguments]&quot;" />
        <CustomAction Id="OpenSSHPreInstall" BinaryKey="WixCA" DllEntry="$(var.QuietExec)" Execute="deferred" Return="ignore" Impersonate="no" />

        <!-- ACTIVE_SESSIONS=abort: an immediate check before InstallValidate (so before anything is changed and before
             Windows Installer looks for files in use) stops the installation with 1603 when OpenSSHPreInstall would end
             an SSH session. The script names the sessions in the log (lines "preinstall: error: ..."); it runs as the
             installing user, and fails closed when it cannot list the processes. close (the default) ends them. -->
        <Property Id="ACTIVE_SESSIONS" Value="close" Secure="yes" />
        <SetProperty Action="SetOpenSSHCheckSessionsCommand" Id="$(var.QuietExecCmdLine)" Sequence="execute" Before="OpenSSHCheckSessions" Value="&quot;[$(var.SystemPowerShellFolder)]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -Command &quot;[PreInstallCommand] '[INSTALLFOLDER]' '[REMOVE]' '' sessions [OpenSSHFeatureArguments]&quot;" />
        <CustomAction Id="OpenSSHCheckSessions" BinaryKey="WixCA" DllEntry="$(var.QuietExec)" Execute="immediate" Return="check" />

        <!-- The sshd firewall rule (server.wxs) belongs to the package: the removal of the old package deletes it and this
             package creates it again with port 22. So that a server moved to another port stays reachable after an
             unattended upgrade or a repair, OpenSSHFirewallSave (deferred, LocalSystem) records the rule's ports,
             networks, enabled state and remote addresses in HKLM\SOFTWARE\OpenSSH\Installer before the old package is
             removed, OpenSSHFirewallProfiles applies them to the new rule, and OpenSSHFirewallCommit deletes the record
             when the installation has succeeded. If it fails, OpenSSHFirewallSaveRollback runs last in the rollback,
             after the old package's rule has been re-created, and puts the saved settings back on it.
             The record is taken only when a package of this series is installed (maintenance, upgrade, downgrade);
             on a fresh install the save step only deletes a record left by an interrupted installation, so the rule
             gets the defaults as before.
             The same steps carry the services over every install, upgrade and repair of the server or the agent (an
             administrator's choice only, so not for the in-box registrations): the save step also records which of sshd
             and ssh-agent are running, and a Disabled or Automatic (Delayed Start) start type of a service registered
             from INSTALLFOLDER. InstallServices registers both again as Automatic and StartServices starts them;
             OpenSSHServicesRestore, after OpenSSHSshdPort, sets the kept start types again and stops a service that is
             Disabled again. The rollback step starts the services that were running: OpenSSHPreInstall stops them before
             StopServices, so the rollback of StopServices does not. Hence the wider condition of these three steps; the
             firewall part of the save step still runs only with &Server = 3 (OpenSSHServerAction "install").
             Placement: RemoveExistingProducts runs the removal of the old package at once, when the action is reached,
             while deferred actions run when the script is executed. A deferred action between InstallInitialize and
             RemoveExistingProducts would therefore run after the removal, and Windows Installer refuses that order
             (error 2613, ICE63). InstallExecute, right after the save step, runs the script built so far, and
             RemoveExistingProducts comes immediately after it, a placement ICE63 accepts. The old package is still
             removed before any file of this package is installed, in the same transaction. -->
        <SetProperty Action="SetOpenSSHFirewallSaveKeep" Id="OpenSSHFirewallSave" Sequence="execute" Before="OpenSSHFirewallSave" Value="&quot;[$(var.SystemPowerShellFolder)]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -Command &quot;[FirewallCommand] '[INSTALLFOLDER]' '' '' fwsave -Previous keep [OpenSSHFeatureArguments]&quot;"><![CDATA[Installed OR OPENSSH_PREVIOUS_INSTALLED OR OPENSSH_NEWER_INSTALLED OR OPENSSH_$(var.OtherArchA)_INSTALLED OR OPENSSH_$(var.OtherArchA)_NEWER_INSTALLED OR OPENSSH_$(var.OtherArchB)_INSTALLED OR OPENSSH_$(var.OtherArchB)_NEWER_INSTALLED]]></SetProperty>
        <SetProperty Action="SetOpenSSHFirewallSaveFresh" Id="OpenSSHFirewallSave" Sequence="execute" Before="OpenSSHFirewallSave" Value="&quot;[$(var.SystemPowerShellFolder)]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -Command &quot;[FirewallCommand] '[INSTALLFOLDER]' '' '' fwsave -Previous none [OpenSSHFeatureArguments]&quot;"><![CDATA[NOT (Installed OR OPENSSH_PREVIOUS_INSTALLED OR OPENSSH_NEWER_INSTALLED OR OPENSSH_$(var.OtherArchA)_INSTALLED OR OPENSSH_$(var.OtherArchA)_NEWER_INSTALLED OR OPENSSH_$(var.OtherArchB)_INSTALLED OR OPENSSH_$(var.OtherArchB)_NEWER_INSTALLED)]]></SetProperty>
        <CustomAction Id="OpenSSHFirewallSave" BinaryKey="WixCA" DllEntry="$(var.QuietExec)" Execute="deferred" Return="ignore" Impersonate="no" />
        <SetProperty Id="OpenSSHFirewallSaveRollback" Sequence="execute" Before="OpenSSHFirewallSaveRollback" Value="&quot;[$(var.SystemPowerShellFolder)]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -Command &quot;[FirewallCommand] '[INSTALLFOLDER]' '' '' fwrollback&quot;" />
        <CustomAction Id="OpenSSHFirewallSaveRollback" BinaryKey="WixCA" DllEntry="$(var.QuietExec)" Execute="rollback" Return="ignore" Impersonate="no" />
        <SetProperty Id="OpenSSHFirewallCommit" Sequence="execute" Before="OpenSSHFirewallCommit" Value="&quot;[$(var.SystemPowerShellFolder)]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -Command &quot;[FirewallCommand] '[INSTALLFOLDER]' '' '' fwcommit&quot;" />
        <CustomAction Id="OpenSSHFirewallCommit" BinaryKey="WixCA" DllEntry="$(var.QuietExec)" Execute="commit" Return="ignore" Impersonate="no" />
        <!-- Settings of the sshd firewall rule, set right after the rule is created (the rule itself comes from server.wxs
             with port 22 and Profile="all"). Networks: FIREWALL_PROFILES (comma list of domain, private, public or all),
             else the saved ones, else all profiles on Windows Server and Domain and Private on client editions. Ports:
             SSHD_PORT, else the saved ones. Enabled state and remote addresses: the saved ones. -->
        <Property Id="FIREWALL_PROFILES" Secure="yes" />
        <SetProperty Id="OpenSSHFirewallProfiles" Sequence="execute" Before="OpenSSHFirewallProfiles" Value="&quot;[$(var.SystemPowerShellFolder)]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -Command &quot;[FirewallCommand] '[INSTALLFOLDER]' '' '' firewall '[FIREWALL_PROFILES]' '[MsiNTProductType]' -SshdPort '[SSHD_PORT]'&quot;" />
        <CustomAction Id="OpenSSHFirewallProfiles" BinaryKey="WixCA" DllEntry="$(var.QuietExec)" Execute="deferred" Return="ignore" Impersonate="no" />

        <!-- SSHD_PORT (1-65535): the firewall rule gets that port (above), and after StartServices has started sshd - which
             creates %ProgramData%\ssh\sshd_config from sshd_config_default at its first start - OpenSSHSshdPort writes
             "Port <n>" into sshd_config (backup sshd_config.bak.<date>-<time>, permissions kept) and restarts sshd. If
             sshd does not listen on the new port, the previous file is put back and the rule gets its port(s) again.
             If the installation fails, OpenSSHSshdPortRollback puts the previous file back (or deletes the one the step
             created), before the rollback of the save step starts sshd again with the old firewall settings. -->
        <Property Id="SSHD_PORT" Secure="yes" />
        <SetProperty Id="OpenSSHSshdPort" Sequence="execute" Before="OpenSSHSshdPort" Value="&quot;[$(var.SystemPowerShellFolder)]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -Command &quot;[FirewallCommand] '[INSTALLFOLDER]' '' '' port -SshdPort '[SSHD_PORT]'&quot;" />
        <CustomAction Id="OpenSSHSshdPort" BinaryKey="WixCA" DllEntry="$(var.QuietExec)" Execute="deferred" Return="ignore" Impersonate="no" />
        <SetProperty Id="OpenSSHSshdPortRollback" Sequence="execute" Before="OpenSSHSshdPortRollback" Value="&quot;[$(var.SystemPowerShellFolder)]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -Command &quot;[FirewallCommand] '[INSTALLFOLDER]' '' '' portrollback&quot;" />
        <CustomAction Id="OpenSSHSshdPortRollback" BinaryKey="WixCA" DllEntry="$(var.QuietExec)" Execute="rollback" Return="ignore" Impersonate="no" />
        <SetProperty Id="OpenSSHServicesRestore" Sequence="execute" Before="OpenSSHServicesRestore" Value="&quot;[$(var.SystemPowerShellFolder)]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -InputFormat None -Command &quot;[FirewallCommand] '[INSTALLFOLDER]' '' '' svcrestore&quot;" />
        <CustomAction Id="OpenSSHServicesRestore" BinaryKey="WixCA" DllEntry="$(var.QuietExec)" Execute="deferred" Return="ignore" Impersonate="no" />

        <!-- OpenSSH Server PN Manager (shared.wxs) needs .NET Framework 4.5 or later, whose setup writes this value. Without it
             the two manager steps below are skipped: the manager cannot start, so nothing can have set up its tasks, and the
             start would only show the message of the .NET Framework - for the uninstall step, which runs as LocalSystem where
             no one can close that window, a wait without end. -->
        <Property Id="NETFX45_RELEASE">
            <RegistrySearch Id="NetFx45Release" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" />
        </Property>

        <!-- When the Server feature is removed (an uninstall or REMOVE=Server; not the removal of this package by an upgrade
             or by the package of another architecture), the manager (its agent job "uninstall") deletes the scheduled tasks of
             its Alerts tab, which run it from the install folder every minute as LocalSystem. Its settings and history in
             %ProgramData%\ssh\manager stay, like sshd_config. Deferred, as LocalSystem, before OpenSSHPreInstall ends the
             runs of those tasks still going and before the files are removed. [INSTALLFOLDER], not [#file]: that one is
             empty for a component being removed. -->
        <SetProperty Id="OpenSSHManagerUninstall" Sequence="execute" Before="OpenSSHManagerUninstall" Value="&quot;[INSTALLFOLDER]OpenSSHServerPNManager.exe&quot; --agent uninstall" />
        <CustomAction Id="OpenSSHManagerUninstall" BinaryKey="WixCA" DllEntry="$(var.QuietExec)" Execute="deferred" Return="ignore" Impersonate="no" />

        <!-- After a first installation of the Server feature run with its window (double-click, msiexec /i; not /quiet,
             /passive or /qb, not an upgrade, a downgrade or a repair), the manager opens its setup wizard. While the files
             are installed, OpenSSHWizardRequest (deferred, LocalSystem) runs the manager with "agent open-wizard", which
             leaves a protected setup request. After InstallFinalize, OpenSSHOpenWizard starts the installed
             asInvoker executable in wizard mode as the installing user. Program explicitly requests elevation
             for the wizard. A file custom action passes the argument directly and does not resolve a shortcut
             through the 32-bit WiX shell helper. OPEN_WIZARD=0 turns it off. Neither step fails installation. -->
        <Property Id="OPEN_WIZARD" Value="1" Secure="yes" />
        <SetProperty Id="OpenSSHFirstInstall" Value="1" Sequence="execute" After="FindRelatedProducts"><![CDATA[NOT (Installed OR OPENSSH_PREVIOUS_INSTALLED OR OPENSSH_NEWER_INSTALLED OR OPENSSH_$(var.OtherArchA)_INSTALLED OR OPENSSH_$(var.OtherArchA)_NEWER_INSTALLED OR OPENSSH_$(var.OtherArchB)_INSTALLED OR OPENSSH_$(var.OtherArchB)_NEWER_INSTALLED)]]></SetProperty>
        <SetProperty Id="OpenSSHWizardRequest" Sequence="execute" Before="OpenSSHWizardRequest" Value="&quot;[INSTALLFOLDER]OpenSSHServerPNManager.exe&quot; --agent open-wizard" />
        <CustomAction Id="OpenSSHWizardRequest" BinaryKey="WixCA" DllEntry="$(var.QuietExec)" Execute="deferred" Return="ignore" Impersonate="no" />
        <CustomAction Id="OpenSSHOpenWizard" FileKey="OpenSSHServerPNManager.exe" ExeCommand="--wizard" Execute="immediate" Return="asyncNoWait" Impersonate="yes" />

        <!-- Cleanup follows actual feature/component actions, including adding Server to a client-only install.
             Adding Client alone cannot stop a retained server. The session check runs only when Server changes.
             Firewall steps run when Server is installed in this transaction; the save, commit and rollback steps, which
             carry the services over, also when the agent is. -->
        <InstallExecuteSequence>
            <Custom Action="OpenSSHCheckSessions" Before="InstallValidate"><![CDATA[ACTIVE_SESSIONS ~= "abort" AND OpenSSHServerAction <> "none"]]></Custom>
            <Custom Action="OpenSSHFirewallSaveRollback" After="InstallInitialize"><![CDATA[&Server = 3 OR $SshAgentComponent = 3]]></Custom>
            <Custom Action="OpenSSHFirewallSave" After="OpenSSHFirewallSaveRollback"><![CDATA[&Server = 3 OR $SshAgentComponent = 3]]></Custom>
            <InstallExecute After="OpenSSHFirewallSave" />
            <RemoveExistingProducts After="InstallExecute" />
            <Custom Action="OpenSSHPreInstall" After="RemoveExistingProducts"><![CDATA[OpenSSHServerAction <> "none" OR OpenSSHClientAction <> "none" OR OpenSSHSharedAction <> "none"]]></Custom>
            <Custom Action="OpenSSHFirewallProfiles" After="$(var.FirewallSchedAction)"><![CDATA[&Server = 3]]></Custom>
            <Custom Action="OpenSSHFirewallCommit" After="OpenSSHFirewallProfiles"><![CDATA[&Server = 3 OR $SshAgentComponent = 3]]></Custom>
            <Custom Action="OpenSSHSshdPortRollback" Before="OpenSSHSshdPort"><![CDATA[SSHD_PORT AND &Server = 3]]></Custom>
            <Custom Action="OpenSSHSshdPort" After="StartServices"><![CDATA[SSHD_PORT AND &Server = 3]]></Custom>
            <Custom Action="OpenSSHServicesRestore" After="OpenSSHSshdPort"><![CDATA[&Server = 3 OR $SshAgentComponent = 3]]></Custom>
            <Custom Action="OpenSSHManagerUninstall" Before="OpenSSHPreInstall"><![CDATA[OpenSSHServerAction = "remove" AND NOT UPGRADINGPRODUCTCODE AND NETFX45_RELEASE]]></Custom>
            <Custom Action="OpenSSHWizardRequest" Before="InstallFinalize"><![CDATA[OPEN_WIZARD = "1" AND UILevel >= 4 AND &Server = 3 AND NETFX45_RELEASE AND OpenSSHFirstInstall]]></Custom>
            <Custom Action="OpenSSHOpenWizard" After="InstallFinalize"><![CDATA[OPEN_WIZARD = "1" AND UILevel >= 4 AND &Server = 3 AND NETFX45_RELEASE AND OpenSSHFirstInstall]]></Custom>
        </InstallExecuteSequence>

        <!-- assume user wants path to be updated when client binaries are installed, can be overridden during install with ADD_PATH=0 -->
        <Property Id="ADD_PATH" Value="1" />

        <Feature Id="Client" AllowAdvertise="no">
            <ComponentGroupRef Id="Client" />
        </Feature>
        <Feature Id="Server" AllowAdvertise="no">
            <ComponentGroupRef Id="Server" />
        </Feature>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="$(var.ProgramFilesFolder)" Name="Program Files">
                <Directory Id="INSTALLFOLDER" Name="OpenSSH" />
            </Directory>
            <!-- The Start-menu shortcuts of the manager (server.wxs); per machine: %ProgramData%\Microsoft\Windows\Start Menu\Programs -->
            <Directory Id="ProgramMenuFolder" />
        </Directory>
    </Product>
</Wix>
